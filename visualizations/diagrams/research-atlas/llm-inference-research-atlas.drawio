        <UserObject id="speculation" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#2459a6;line-height:1.2&quot;&gt;增加周期有效产出 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;投机生成与可用原生 MTP&lt;br&gt;同时改变 K、F、D、M&lt;br&gt;代价：草稿、验证与回滚&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/theory/generation/README.md" linkTarget="_blank" tooltip="theory/generation/README.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#8caee0;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">

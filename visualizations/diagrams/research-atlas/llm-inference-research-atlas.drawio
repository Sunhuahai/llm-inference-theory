        <UserObject id="residency" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#2459a6;line-height:1.2&quot;&gt;改善状态驻留 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;分页、共享、释放与恢复&lt;br&gt;改变 M、可行 batch 与恢复&lt;br&gt;代价：管理、搬运或重算&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/theory/memory/README.md" linkTarget="_blank" tooltip="theory/memory/README.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#8caee0;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">

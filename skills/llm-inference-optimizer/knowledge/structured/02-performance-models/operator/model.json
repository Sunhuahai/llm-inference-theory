      "unit": "byte",
      "description": "实际预计流量"
    },
    {
      "id": "effective_compute",
      "unit": "FLOP/s",
      "description": "工作点有效算力"
    },
    {
      "id": "effective_bandwidth",
      "unit": "byte/s",
      "description": "工作点有效带宽"
    }
  ],
  "outputs": [
    {
      "id": "time",
      "unit": "s",
      "description": "算子时间估计"
    },
    {
      "id": "time_ms",
      "unit": "ms",
      "description": "算子时间估计"
    }

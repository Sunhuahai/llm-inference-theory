{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Primary prediction model reference",
  "type": "object",
  "required": [
    "id",
    "revision",
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "output": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "parameter_sets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
      },
      "uniqueItems": true
    }
  }
}

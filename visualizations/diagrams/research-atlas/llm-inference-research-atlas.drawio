        <mxCell id="decor-3" value="02｜如何改变系统：优化机制、代价与耦合" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Noto Sans CJK SC;fontSize=46;fontColor=#ffffff;fontStyle=1;connectable=0;" vertex="1" parent="1">

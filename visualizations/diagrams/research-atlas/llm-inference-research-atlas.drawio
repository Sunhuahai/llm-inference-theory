        <UserObject id="ledger" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#087a78;line-height:1.2&quot;&gt;资源变换账本 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;F、D、C、M、执行图、K&lt;br&gt;同时记录节省和新增成本&lt;br&gt;多种物理单位不能直接相加&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/theory/optimization/mechanisms.md" linkTarget="_blank" tooltip="theory/optimization/mechanisms.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#80beb5;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">
            <mxGeometry x="1535" y="410" width="650" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="candidate" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#7042a6;line-height:1.2&quot;&gt;候选身份与条件 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;parent、适用域与前置条件&lt;br&gt;依赖、冲突和允许修改范围&lt;br&gt;未知项保留 unknown&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/optimizer/search-space/README.md" linkTarget="_blank" tooltip="optimizer/search-space/README.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#b39ace;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">
            <mxGeometry x="2255" y="410" width="650" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="fusion" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#2459a6;line-height:1.2&quot;&gt;减少中间搬运 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;融合、分块、在线归一化&lt;br&gt;改变流量 D 和执行边&lt;br&gt;代价：寄存器、spill 与并发&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/theory/optimization/mechanisms.md" linkTarget="_blank" tooltip="theory/optimization/mechanisms.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#8caee0;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">
            <mxGeometry x="95" y="800" width="650" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="mapping" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#2459a6;line-height:1.2&quot;&gt;改善资源映射 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;Tile、布局、后端与形状特化&lt;br&gt;改善有效计算或带宽速率&lt;br&gt;代价：编译成本与适用域&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/models/operator/README.md" linkTarget="_blank" tooltip="models/operator/README.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#8caee0;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">
            <mxGeometry x="815" y="800" width="650" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="rebuild" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#087a78;line-height:1.2&quot;&gt;候选后重新建模 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;更新资源、形状与执行图&lt;br&gt;重算容量及服务工作点&lt;br&gt;新增开销不能漏计或重复计&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/models/README.md" linkTarget="_blank" tooltip="models/README.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#80beb5;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">

{
  "schema_version": 2,
  "id": "PERF-OPERATOR",
  "revision": 1,
  "layer": "02-performance-models",
  "kind": "performance_model",
  "title": "算子时间预测",
  "formula": "T_hat=max(F/P_eff,D/B_eff)+t_exposed",

        <UserObject id="interaction" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#a96612;line-height:1.2&quot;&gt;四组交互实验 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;基线、A、B、A＋B&lt;br&gt;ΔAB = TA + TB − T0 − TAB&lt;br&gt;保留重复块与测量相关性&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/theory/optimization/coupling.md" linkTarget="_blank" tooltip="theory/optimization/coupling.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#dfbb7c;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">

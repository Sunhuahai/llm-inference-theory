        </mxCell>
        <mxCell id="decor-4" value="每项技术都应还原为资源变化与新增代价；收益绑定当前基线，组合之后重新建模和独立验证。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#c9d8e5;fontStyle=0;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="91" width="1075" height="37.5" as="geometry" />

        <UserObject id="benefit" label="&lt;div style=&quot;font-size:29px;font-weight:bold;color:#087a78;line-height:1.2&quot;&gt;条件收益与瓶颈迁移 ↗&lt;/div&gt;&lt;div style=&quot;font-size:24px;color:#3d5264;line-height:1.42;margin-top:14px&quot;&gt;收益绑定当前 parent&lt;br&gt;解除一类约束后另一类显露&lt;br&gt;S总 = SA × S(B｜A)&lt;/div&gt;" link="https://github.com/Sunhuahai/llm-inference-theory/blob/main/theory/optimization/coupling.md" linkTarget="_blank" tooltip="theory/optimization/coupling.md">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=20;fillColor=#ffffff;strokeColor=#80beb5;strokeWidth=2;fontFamily=Noto Sans CJK SC;overflow=hidden;" vertex="1" parent="1">
